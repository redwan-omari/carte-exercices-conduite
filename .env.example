# Copiez ce fichier en `.env.local` pour le développement local.
# Supabase > Project Settings > API (ou "API Keys")

# URL du projet Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé PUBLIQUE uniquement : "publishable key" (sb_publishable_...) ou ancienne clé "anon".
# Elle est conçue pour être visible dans le navigateur ; la sécurité repose sur les règles RLS.
# NE JAMAIS mettre ici la clé "service_role" ni une "secret key" (sb_secret_...).
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
